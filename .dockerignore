# Never send local configuration or credentials to the Docker daemon. The
# example is explicitly safe to retain when the project adds one again.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
.npmrc.local

# Local/editor noise
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker metadata is supplied separately by the builder.
Dockerfile
docker-compose.yml
.dockerignore
